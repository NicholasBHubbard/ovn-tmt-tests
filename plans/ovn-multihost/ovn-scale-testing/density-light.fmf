# Create a small OVN network across the available compute chassis, verify
# endpoint connectivity, and measure convergence as logical ports are added.
summary: Measure incremental OVN logical port convergence
enabled: true

environment+:
  OTT_SCALE_INITIAL_PORTS: "2"
  OTT_SCALE_ITERATIONS: "3"

discover:
  how: fmf
  where: [central]
  adjust-tests:
    - duration: $OTT_SCALE_DURATION
  test:
    - /tests/scale/density-light
