summary: Combined passing and failing test report
enabled: false

adjust:
  when: temporary-report-demo == true
  enabled: true

environment+:
  OTT_INSTALL_METHOD: distro
  OTT_SCALE_WORKERS: "2"
  OTT_SCALE_BASE_PODS_PER_WORKER: "2"
  OTT_SCALE_INITIAL_PODS: "4"
  OTT_SCALE_TOTAL_PODS: "6"
  OTT_SCALE_PODS_PER_SERVICE: "2"
  OTT_SCALE_LB_PROTOCOLS: tcp,udp,sctp
  OTT_SCALE_IPV6: "false"
  OTT_SCALE_TIMEOUT: "30"
  OTT_SCALE_SYNC_TIMEOUT: "600"
  OTT_SCALE_DURATION: 20m

discover:
  - name: density-heavy
    how: fmf
    order: 40
    where: [central]
    adjust-tests:
      - duration: $OTT_SCALE_DURATION
    test:
      - /tests/scale/density-heavy

  - name: intentional-failure
    how: fmf
    order: 50
    where: [central]
    test:
      - /tests/failures/execution
