summary: Test OVN topology roles on Fedora

provision:
  - how: virtual
    image: fedora

prepare:
  - name: Set up OVN central
    how: ansible
    playbook: playbooks/ovn-central.yml
    extra-args: '-e ovn_install_method=distro -e ovs_setup_install_method=distro'
  - name: Check OVN topology preconditions
    how: shell
    order: 80
    script: python3 -m pytest ./tests/self/ovn-topology/test.py::TestPreconditions
  - name: Verify invalid router configurations are rejected
    how: ansible
    order: 84
    playbook: tests/self/ovn-topology/invalid-router.yml
  - name: Verify invalid gateway chassis configurations are rejected
    how: ansible
    order: 85
    playbook: tests/self/ovn-topology/invalid-gateway-chassis.yml
  - name: Verify invalid load balancer configurations are rejected
    how: ansible
    order: 86
    playbook: tests/self/ovn-topology/invalid-load-balancer.yml
  - name: Verify invalid localnet port configurations are rejected
    how: ansible
    order: 87
    playbook: tests/self/ovn-topology/invalid-localnet-port.yml
  - name: Verify invalid NAT rule configurations are rejected
    how: ansible
    order: 88
    playbook: tests/self/ovn-topology/invalid-nat-rule.yml
  - name: Verify invalid router port configurations are rejected
    how: ansible
    order: 89
    playbook: tests/self/ovn-topology/invalid-router-port.yml
  - name: Verify invalid static route configurations are rejected
    how: ansible
    order: 90
    playbook: tests/self/ovn-topology/invalid-static-route.yml
  - name: Apply initial OVN topology
    how: ansible
    order: 91
    playbook: tests/self/ovn-topology/initial.yml
  - name: Verify failed router updates preserve state
    how: ansible
    order: 94
    playbook: tests/self/ovn-topology/invalid-router-update.yml
  - name: Verify failed localnet port updates are atomic
    how: ansible
    order: 95
    playbook: tests/self/ovn-topology/invalid-localnet-port-update.yml
  - name: Verify failed NAT rule updates are atomic
    how: ansible
    order: 96
    playbook: tests/self/ovn-topology/invalid-nat-rule-update.yml
  - name: Verify failed router port updates are atomic
    how: ansible
    order: 97
    playbook: tests/self/ovn-topology/invalid-router-port-update.yml
  - name: Verify static route update failures are safe
    how: ansible
    order: 98
    playbook: tests/self/ovn-topology/invalid-static-route-update.yml
  - name: Verify initial OVN topology
    how: shell
    order: 100
    script: python3 -m pytest ./tests/self/ovn-topology/test.py::TestInitial
  - name: Reconfigure OVN topology
    how: ansible
    order: 110
    playbook: tests/self/ovn-topology/reconfigure.yml
  - name: Record reconfigured OVN topology
    how: shell
    order: 120
    script: python3 -m pytest ./tests/self/ovn-topology/test.py::TestReconfigured
  - name: Reapply OVN topology
    how: ansible
    order: 130
    playbook: tests/self/ovn-topology/reapply.yml
