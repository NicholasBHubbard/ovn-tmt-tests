summary: Minimal OVN cluster (3 central nodes) on Fedora

environment:
  OTT_TEST_CLUSTER_MEMBERS: "2"

provision:
  - name: central-1
    role: leader
    how: virtual
    image: fedora
    connection: system
  - name: central-2
    role: follower
    how: virtual
    image: fedora
    connection: system
  - name: central-3
    role: follower
    how: virtual
    image: fedora
    connection: system

prepare+:
  - name: Check preconditions on all nodes
    how: shell
    where: [leader, follower]
    order: 80
    script: python3 -m pytest ./tests/self/ovn-clustered/test.py::TestPreconditions

  - name: Set up cluster leader
    how: ansible
    order: 90
    playbook: playbooks/ovn-clustered.yml
    extra-args: '-e ovn_install_method=distro -e ovs_setup_install_method=distro'
    where: [leader]

  - name: Set up cluster followers
    how: ansible
    order: 100
    playbook: playbooks/ovn-clustered.yml
    extra-args: '-e ovn_install_method=distro -e ovs_setup_install_method=distro'
    where: [follower]

  - name: Reapply cluster leader configuration
    how: ansible
    order: 105
    playbook: playbooks/ovn-clustered.yml
    extra-args: '-e ovn_install_method=distro -e ovs_setup_install_method=distro'
    where: [leader]

  - name: Reapply cluster follower configuration
    how: ansible
    order: 106
    playbook: playbooks/ovn-clustered.yml
    extra-args: '-e ovn_install_method=distro -e ovs_setup_install_method=distro'
    where: [follower]

  - name: Remove obsolete cluster member
    how: ansible
    order: 107
    playbook: tests/self/ovn-clustered/remove-member.yml
    where: [leader]

  - name: Verify northd connections on all nodes
    how: shell
    where: [leader, follower]
    order: 110
    script: python3 -m pytest ./tests/self/ovn-clustered/test.py::TestNorthdConnections

discover:
  - how: fmf
    where:
      - leader
    test:
      - /tests/self/ovn-clustered
