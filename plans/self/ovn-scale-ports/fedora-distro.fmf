summary: Test ovn-scale-ports role on Fedora

provision:
  - how: virtual
    image: fedora

prepare:
  - name: Set up OVN central
    how: ansible
    playbook: playbooks/ovn-central.yml
    extra-args: '-e ovn_install_method=distro -e ovs_setup_install_method=distro'
  - name: Check scale port preconditions
    how: shell
    order: 80
    script: >-
      python3 -m pytest
      ./tests/self/ovn-scale-ports/test.py::TestPreconditions
  - name: Create scale port topology
    how: ansible
    order: 90
    playbook: tests/self/ovn-scale-ports/topology.yml
  - name: Configure the scale port chassis
    how: ansible
    order: 95
    playbook: tests/self/ovn-scale-ports/chassis.yml
  - name: Create three passive scale ports
    how: ansible
    order: 100
    playbook: tests/self/ovn-scale-ports/apply.yml
    extra-args: -e ovn_scale_ports_count=3
  - name: Verify initial scale ports
    how: shell
    order: 110
    script: python3 -m pytest ./tests/self/ovn-scale-ports/test.py::TestInitial
  - name: Reapply three passive scale ports
    how: ansible
    order: 120
    playbook: tests/self/ovn-scale-ports/apply.yml
    extra-args: -e ovn_scale_ports_count=3
  - name: Verify reapplied scale ports
    how: shell
    order: 130
    script: python3 -m pytest ./tests/self/ovn-scale-ports/test.py::TestReapplied
  - name: Contract passive scale ports to two
    how: ansible
    order: 140
    playbook: tests/self/ovn-scale-ports/apply.yml
    extra-args: -e ovn_scale_ports_count=2
  - name: Verify contracted scale ports
    how: shell
    order: 150
    script: python3 -m pytest ./tests/self/ovn-scale-ports/test.py::TestContracted
