summary: Test ovn-sb-convergence role on Fedora

provision:
  - how: virtual
    image: fedora

prepare:
  - name: Set up OVN central
    how: ansible
    playbook: playbooks/ovn-central.yml
    extra-args: '-e ovn_install_method=distro'
  - name: Check Southbound convergence preconditions
    how: shell
    order: 80
    script: >-
      python3 -m pytest
      ./tests/self/ovn-sb-convergence/test.py::TestPreconditions
  - name: Verify present Southbound objects converge
    how: ansible
    order: 90
    playbook: tests/self/ovn-sb-convergence/present.yml
  - name: Check present Southbound objects
    how: shell
    order: 100
    script: python3 -m pytest ./tests/self/ovn-sb-convergence/test.py::TestPresent
  - name: Verify removed Southbound objects converge
    how: ansible
    order: 110
    playbook: tests/self/ovn-sb-convergence/absent.yml
