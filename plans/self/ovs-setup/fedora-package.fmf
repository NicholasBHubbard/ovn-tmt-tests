summary: Test ovs-setup with packaged OVS on Fedora

provision:
  - how: virtual
    image: fedora

prepare+:
  - name: Install OVS
    how: install
    order: 70
    package:
      - openvswitch
  - how: shell
    order: 80
    script: python3 -m pytest ./tests/self/ovs-setup/test.py::TestPreconditions
  - how: ansible
    order: 90
    playbook: playbooks/ovs-setup.yml
