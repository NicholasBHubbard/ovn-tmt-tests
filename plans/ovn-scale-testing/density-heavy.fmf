# Build a Kubernetes-like OVN topology across the available compute chassis,
# populate its workers with pods and load-balanced services, then measure
# incremental convergence while verifying pod and external gateway traffic.
summary: Measure incremental OVN pod and service convergence
enabled: true

environment+:
  OTT_CLUSTERED: "true"
  OTT_COMPUTE_PHYSICAL_BRIDGE: br-ex
  OTT_COMPUTE_PHYSICAL_NETWORK: physnet
  OTT_MONITOR_ALL: "true"
  OTT_SCALE_BASE_PODS_PER_WORKER: "10"
  OTT_SCALE_DURATION: 6h
  OTT_SCALE_INITIAL_PODS: "11000"
  OTT_SCALE_IPV6: "false"
  OTT_SCALE_PODS_PER_SERVICE: "2"
  OTT_SCALE_LB_PROTOCOLS: tcp,udp,sctp
  OTT_SCALE_SERVICE_BACKEND_PORT: "8080"
  OTT_SCALE_SERVICE_VIP_IPV4_NETWORK: 100.0.0.0/16
  OTT_SCALE_SERVICE_VIP_IPV6_NETWORK: "100::/64"
  OTT_SCALE_SERVICE_VIP_PORT: "80"
  OTT_SCALE_TOTAL_PODS: "11250"
  OTT_SCALE_WORKERS: "250"

provision+:
  - name: central-2
    role: central-follower
    how: virtual
    image: fedora
    connection: system
  - name: central-3
    role: central-follower
    how: virtual
    image: fedora
    connection: system

discover:
  how: fmf
  where: [central]
  adjust-tests:
    - duration: $OTT_SCALE_DURATION
  test:
    - /tests/ovn-scale-testing/density-heavy
