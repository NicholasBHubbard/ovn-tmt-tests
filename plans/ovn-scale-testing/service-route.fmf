# Create cluster-wide and per-worker load balancers backed by pod endpoints,
# then measure their creation and verify the endpoint network paths.
summary: Measure OVN service-route convergence
enabled: true

environment+:
  OTT_CLUSTERED: "true"
  OTT_COMPUTE_PHYSICAL_BRIDGE: br-ex
  OTT_COMPUTE_PHYSICAL_NETWORK: physnet
  OTT_MONITOR_ALL: "true"
  OTT_SCALE_BASE_PODS_PER_WORKER: "2"
  OTT_SCALE_DURATION: 1h
  OTT_SCALE_IPV6: "true"
  OTT_SCALE_LB_PROTOCOLS: tcp,udp,sctp
  OTT_SCALE_SERVICE_BACKENDS: "4"
  OTT_SCALE_SERVICE_LOAD_BALANCERS: "16"
  OTT_SCALE_WORKERS: "2"

provision+:
  - name: central-2
    role: central-follower
    how: virtual
    image: fedora
    connection: system
  - name: central-3
    role: central-follower
    how: virtual
    image: fedora
    connection: system

discover:
  how: fmf
  where: [central]
  adjust-tests:
    - duration: $OTT_SCALE_DURATION
  test:
    - /tests/ovn-scale-testing/service-route
